<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Add Water — Water Intake Tracker</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600&family=Nunito:wght@400;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/style.css">
</head>
<body>

<div id="water-tracker-app">

  <nav class="wt-nav">
    <a class="wt-nav-link" href="/water">Water</a>
    <a class="wt-nav-link active" href="/water-add">Add</a>
    <a class="wt-nav-link" href="/water-history">History</a>
  </nav>

  <header class="wt-header">
    <div>
      <p class="wt-eyebrow">Log water intake</p>
      <h1 class="wt-title">Add a drink</h1>
    </div>
  </header>

  <main class="wt-main">
    <section class="wt-quickadd" aria-label="Log water">
      <form method="POST" action="/water-add" style="display:inline;">
        <button class="wt-chip" type="submit" name="amount" value="150">+150 ml</button>
      </form>
      <form method="POST" action="/water-add" style="display:inline;">
        <button class="wt-chip" type="submit" name="amount" value="250">+250 ml</button>
      </form>
      <form method="POST" action="/water-add" style="display:inline;">
        <button class="wt-chip" type="submit" name="amount" value="500">+500 ml</button>
      </form>

      <form class="wt-custom-form" method="POST" action="/water-add">
        <input class="wt-custom-input" name="amount" type="number" min="1" step="1" placeholder="Custom ml" inputmode="numeric" required>
        <button class="wt-custom-submit" type="submit">Add</button>
      </form>
    </section>

    <p class="wt-empty"><%= consumed %> / <%= goal %> ml logged today</p>
    <p class="wt-empty"><a href="/water">View full progress</a></p>
  </main>
</div>

</body>
</html>
