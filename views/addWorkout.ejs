<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Add Workout</title>

    <link
        rel="stylesheet"
        href="/style.css"
    >

</head>

<body>

    <header>

        <h1>Add Workout</h1>

    </header>

    <nav>

        <a href="/">Dashboard</a>

        <a href="/addWorkout">Add Workout</a>

        <a href="/exerciseHistory">Exercise History</a>

        <a href="/bmi">BMI Tracker</a>

        <a href="/calorie">Calorie Tracker</a>

        <a href="/logout">Logout</a>

    </nav>

    <div class="container">

        <h2>Add Workout</h2>

        <form
            action="/addWorkout"
            method="POST"
        >

            <label>
                Exercise
            </label>

            <select
                id="activity"
                name="activity"
                required
            >

                <option value="">
                    Select Exercise
                </option>

                <option>Running</option>
                <option>Walking</option>
                <option>Cycling</option>
                <option>Swimming</option>
                <option>Gym</option>
                <option>Football</option>
                <option>Basketball</option>
                <option>Badminton</option>

            </select>

            <label>
                Duration (Minutes)
            </label>

            <input
                type="number"
                id="minutes"
                name="minutes"
                min="1"
                required
            >

            <label>
                Calories Burned
            </label>

            <input
                type="number"
                id="caloriesBurned"
                name="caloriesBurned"
                readonly
            >

            <label>
                Workout Date
            </label>

            <input
                type="date"
                name="workoutDate"
                required
            >

            <label>
                Workout Time
            </label>

            <input
                type="time"
                name="workoutTime"
                required
            >

            <button type="submit">

                Save Workout

            </button>

        </form>

    </div>

    <script>

        const activity = document.getElementById("activity");

        const minutes = document.getElementById("minutes");

        const calories = document.getElementById("caloriesBurned");

        const calorieRates = {

            Running: 10,
            Walking: 4,
            Cycling: 8,
            Swimming: 9,
            Gym: 6,
            Football: 9,
            Basketball: 8,
            Badminton: 7

        };

        function calculateCalories() {

            const rate = calorieRates[activity.value] || 0;

            const duration = Number(minutes.value) || 0;

            calories.value = rate * duration;

        }

        activity.addEventListener("change", calculateCalories);

        minutes.addEventListener("input", calculateCalories);

    </script>

</body>

</html>