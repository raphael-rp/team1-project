<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Water History — Water Intake Tracker</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600&family=Nunito:wght@400;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/style.css">
</head>
<body>

<div id="water-tracker-app">

  <nav class="wt-nav">
    <a class="wt-nav-link" href="/water">Water</a>
    <a class="wt-nav-link" href="/water-add">Add</a>
    <a class="wt-nav-link active" href="/water-history">History</a>
  </nav>

  <header class="wt-header">
    <div>
      <p class="wt-eyebrow">Past days</p>
      <h1 class="wt-title">Water History</h1>
    </div>
  </header>

  <main class="wt-main">
    <section class="wt-history" aria-label="Past days">
      <ul class="wt-history-list">
        <% days.forEach(function(day) { %>
          <% const hit = day.total >= goal; %>
          <li class="wt-history-item">
            <span class="wt-history-date">
              <%= new Date(day.logDate).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' }) %>
            </span>
            <span class="wt-history-right">
              <span class="wt-history-total"><%= day.total %> ml</span>
              <span class="wt-history-badge <%= hit ? 'hit' : 'miss' %>"><%= hit ? 'Goal hit' : 'Under goal' %></span>
            </span>
          </li>
        <% }); %>
      </ul>
      <% if (days.length === 0) { %>
        <p class="wt-empty">No previous days yet — history builds up as you use the tracker day to day.</p>
      <% } %>
    </section>
  </main>
</div>

</body>
</html>
