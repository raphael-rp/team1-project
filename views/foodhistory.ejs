<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Food History</title>

    <link rel="stylesheet" href="/style.css">


    <style>

        body{
            margin:0;
            font-family:Arial, Helvetica, sans-serif;
            background:#f4f4f4;
        }


        header{
            background:#22c55e;
            color:white;
            text-align:center;
            padding:20px;
        }
        
        .container{

            width:800px;
            margin:40px auto;
            background:white;
            padding:30px;
            border-radius:10px;
            box-shadow:0 0 10px rgba(0,0,0,.1);

        }


        .user-info{

            text-align:right;
            color:#666;
            font-size:14px;
            margin-bottom:20px;

        }


        .history-card{

            border:1px solid #ddd;
            border-radius:8px;
            padding:15px;
            margin-bottom:15px;
            background:white;

        }


        .total{

            background:#22c55e;
            color:white;
            padding:15px;
            border-radius:8px;
            font-size:20px;
            margin-bottom:20px;
            text-align:center;

        }


    </style>


</head>


<body>


<header>

    <h1>Food History</h1>

</header>



<nav>

    <a href="/">Dashboard</a>

    <a href="/addWorkout">Add Workout</a>

    <a href="/calorie">Calorie Tracker</a>

    <a href="/logout">Logout</a>

</nav>



<div class="container">


    <p class="user-info">

        Logged in as

        <b>
            <%= account.email %>
        </b>

    </p>



    <h2>Meal History</h2>



    <div class="total">

        Total Calories:

        <%= meals.reduce((sum, meal) => sum + Number(meal.calories), 0) %>

        kcal

    </div>




    <% if(meals.length === 0){ %>


        <p>
            No meals recorded yet.
        </p>


    <% } else { %>



        <% meals.forEach(meal => { %>


            <div class="history-card">


                <h3>
                    <%= meal.mealName %>
                </h3>



                <p>

                    <strong>
                        Calories:
                    </strong>

                    <%= meal.calories %> kcal

                </p>




                <p>

                    <strong>
                        Date:
                    </strong>


                    <%= new Date(meal.mealDate).toISOString().split("T")[0] %>

                </p>



            </div>



        <% }) %>



    <% } %>



</div>



</body>

</html>