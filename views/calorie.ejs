<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Calorie Tracker</title>

    <link rel="stylesheet" href="/style.css">

    <style>
        body{
            margin:0;
            font-family:Arial, Helvetica, sans-serif;
            background:#f4f4f4;
        }

        header{
            background:#22c55e;
            color:white;
            text-align:center;
            padding:20px;
        }

        .container{
            max-width:900px;
            margin:40px auto;
            background:white;
            padding:30px;
            border-radius:10px;
            box-shadow:0 0 10px rgba(0,0,0,.1);
        }

        h2{
            margin-top:0;
        }

        .button-grid{
            display:grid;
            grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
            gap:20px;
            margin-top:30px;
        }

        .button-grid button{
            padding:18px;
            font-size:18px;
            font-weight:bold;
            border:none;
            border-radius:10px;
            cursor:pointer;
            background:#22c55e;
            color:white;
            transition:.3s;
        }

        .button-grid button:hover{
            background:#16a34a;
            transform:translateY(-3px);
        }
    </style>
</head>

<body>

<header>
    <h1>Calorie Tracker</h1>
</header>

<nav>
    <a href="/">Dashboard</a>
    <a href="/add">Add Workout</a>
    <a href="/calorie">Calorie Tracker</a>
    <a href="/logout">Logout</a>
</nav>

<div class="container">

    <h2>Meal Management</h2>

    <p>
        Manage your daily meals and calorie intake.
    </p>

    <div class="button-grid">

        <button onclick="window.location.href='/addMeal'">
            ➕ Add Meal
        </button>

        <button onclick="window.location.href='/editMeal'">
            ✏️ Edit / Delete Meals
        </button>

        <button onclick="window.location.href='/foodhistory'">
            📜 Food History
        </button>

        <button onclick="window.location.href='/searchMeal'">
            🔍 Search Meals
        </button>

    </div>

</div>

</body>
</html>