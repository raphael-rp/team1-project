<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Edit Meals</title>

<link rel="stylesheet" href="/style.css">

</head>


<body>


<header>
    <h1>Edit Meals</h1>
</header>

<%- include('partials/nav') %>



<div class="container">


<h2>Edit or Delete Meals</h2>



<% if(meals.length === 0){ %>

    <p>No meals found.</p>


<% } else { %>



<% meals.forEach(meal => { %>


<div class="meal-card">


<form action="/editMeal/<%= meal._id %>" method="POST">


<label>
    Meal Name
</label>


<input
    type="text"
    name="mealName"
    value="<%= meal.mealName %>"
    required
>



<label>
    Calories
</label>


<input
    type="number"
    name="calories"
    value="<%= meal.calories %>"
    min="0"
    required
>



<label>
    Date
</label>


<input
    type="date"
    name="mealDate"
    value="<%= meal.mealDate.toISOString().split('T')[0] %>"
    max="<%= new Date().toISOString().split('T')[0] %>"
    required
>



<div class="button-group">


<button class="save-btn" type="submit">
    Save Changes
</button>


</form>



<form
action="/deleteMeal/<%= meal._id %>"
method="POST"
onsubmit="return confirm('Delete this meal?');"
>


<button class="delete-btn" type="submit">
    Delete
</button>


</form>


</div>


</div>


<% }) %>


<% } %>



</div>


</body>
</html>
