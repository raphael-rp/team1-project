<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Exercise History</title>

    <link
        rel="stylesheet"
        href="/style.css"
    >

</head>

<body>

    <header>

        <h1>Exercise History</h1>

    </header>

    <%- include('partials/nav') %>

    <div class="container">

        <h2>Workout History</h2>

        <input
            type="text"
            id="searchWorkout"
            placeholder="Search workout..."
        >

        <br>
        <br>

        <% if (workouts.length === 0) { %>

            <p>No workouts found.</p>

        <% } else { %>

            <table id="workoutTable">

                <thead>

                    <tr>

                        <th>Exercise</th>
                        <th>Minutes</th>
                        <th>Calories</th>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Actions</th>

                    </tr>

                </thead>

                <tbody>

                    <% workouts.forEach(workout => { %>

                        <tr>

                            <td>
                                <%= workout.activity %>
                            </td>

                            <td>
                                <%= workout.minutes %>
                            </td>

                            <td>
                                <%= workout.caloriesBurned %> kcal
                            </td>

                            <td>
                                <%= new Date(workout.workoutDate).toISOString().split("T")[0] %>
                            </td>

                            <td>
                                <%= workout.workoutTime %>
                            </td>

                            <td>

                                <a href="/editWorkout/<%= workout.workoutId %>">

                                    <button>

                                        Edit

                                    </button>

                                </a>

                                <form
                                    action="/deleteWorkout/<%= workout.workoutId %>"
                                    method="POST"
                                    style="display:inline;"
                                >

                                    <button
                                        type="submit"
                                        onclick="return confirm('Delete this workout?')"
                                    >

                                        Delete

                                    </button>

                                </form>

                            </td>

                        </tr>

                    <% }) %>

                </tbody>

            </table>

        <% } %>

    </div>

    <script>

        const searchInput =
            document.getElementById("searchWorkout");

        searchInput.addEventListener("keyup", function () {

            const filter =
                this.value.toUpperCase();

            const rows =
                document.querySelectorAll("#workoutTable tbody tr");

            rows.forEach(row => {

                const activity =
                    row.cells[0].textContent.toUpperCase();

                if (activity.includes(filter)) {

                    row.style.display = "";

                }
                else {

                    row.style.display = "none";

                }

            });

        });

    </script>

</body>

</html>
